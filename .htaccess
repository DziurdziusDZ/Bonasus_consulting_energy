RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Blokada przeglądania katalogów z poziomu przeglądarki
Options -Indexes

# Blokada odczytu plików ukrytych i systemowych
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Nagłówki ochronne przed atakami ramkowymi i podszywaniem MIME
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>